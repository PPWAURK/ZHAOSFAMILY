{
  "expo": {
    "name": "ZHAO's Family",
    "slug": "zhao-family-mobile",
    "scheme": "zhaofamily",
    "version": "0.1.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/play-store/app-icon-1024.png",
    "splash": {
      "backgroundColor": "#6F0D10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.zhao.family",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "13"
    },
    "android": {
      "package": "com.zhao.family",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/play-store/adaptive-foreground-1024.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
      ],
      "versionCode": 20
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "./plugins/with-google-utilities-modular-headers",
      "@react-native-firebase/analytics",
      "./plugins/with-disable-ad-id",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择一张头像用于员工档案。",
          "cameraPermission": "拍摄一张头像用于员工档案。",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#6F0D10"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c17788a6-0cf8-491f-a706-5a41349cd914"
      }
    },
    "owner": "panned"
  }
}
