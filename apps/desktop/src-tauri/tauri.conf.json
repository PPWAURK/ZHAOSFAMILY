{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZHAO's Family",
  "version": "0.1.0",
  "identifier": "com.zhao.family.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @zhao/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @zhao/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZHAO's Family",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
